@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime Js

@code {
  [Parameter] public EventCallback OnVisible { get; set; }

  private Task? _initialization;
  private IJSObjectReference? _module;
  private IJSObjectReference? _subscription;
  private DotNetObjectReference<PageVisibilityWatcher>? _reference;
  private bool _disposed;

  protected override Task OnAfterRenderAsync(bool firstRender) => firstRender && !_disposed
    ? _initialization = InitializeAsync()
    : Task.CompletedTask;

  private async Task InitializeAsync()
  {
    try
    {
      _module = await Js.InvokeAsync<IJSObjectReference>("import", "./js/page-visibility.js");
      if (_disposed) return;
      _reference = DotNetObjectReference.Create(this);
      _subscription = await _module.InvokeAsync<IJSObjectReference>("subscribe", _reference);
    }
    catch (Exception exception) when (exception is JSException or InvalidOperationException)
    {
    }
  }

  [JSInvokable]
  public Task OnVisibilityChangedAsync() => _disposed ? Task.CompletedTask : OnVisible.InvokeAsync();

  public async ValueTask DisposeAsync()
  {
    if (_disposed) return;
    _disposed = true;
    if (_initialization is not null) await _initialization;
    try
    {
      if (_subscription is not null)
      {
        await _subscription.InvokeVoidAsync("dispose");
        await _subscription.DisposeAsync();
      }
    }
    catch (JSException)
    {
    }
    finally
    {
      _reference?.Dispose();
      if (_module is not null)
      {
        try { await _module.DisposeAsync(); }
        catch (JSException) { }
      }
    }
  }
}
