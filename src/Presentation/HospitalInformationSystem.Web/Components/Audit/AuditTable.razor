@using HospitalInformationSystem.Application.Models.Security

<div class="table-responsive">
  <table class="table mr-table audit-table">
    <thead>
    <tr>
      <th scope="col">Время</th>
      <th scope="col">Тип события</th>
      <th scope="col">Инициатор</th>
      <th scope="col">Сообщение</th>
      <th scope="col">Результат</th>
    </tr>
    </thead>
    <tbody>
    @foreach (var item in Items)
    {
      var import = Hl7ImportAuditDisplayFactory.Create(item);
      var detailsKey = $"hl7-details-{item.EventId}";
      <tr @key="item.EventId" data-event-id="@item.EventId" class="@(import is not null ? "hl7-audit-event-row" : null)">
        <td data-label="Время">@item.EventTime.ToLocalTime().ToString("dd.MM.yyyy HH:mm:ss")</td>
        <td data-label="Тип события">@AuditLabels.EventType(item.EventType)</td>
        <td data-label="Инициатор">
          <span class="actor-kind actor-@item.Actor.Kind.ToString().ToLowerInvariant()">@AuditLabels.ActorKind(item.Actor)</span>
          <span class="actor-title">@AuditLabels.ActorTitle(item.Actor)</span>
          @if (AuditLabels.ActorDetail(item.Actor) is { } detail)
          {
            <small class="actor-detail">@detail</small>
          }
        </td>
        <td data-label="Сообщение">
          @item.Message
          @if (AuditLabels.RefreshRevocationSummary(item.Metadata) is { } revocation)
          {
            <small class="field-hint d-block">@revocation</small>
          }
        </td>
        <td data-label="Результат">
          @if (import is not null)
          {
            <span class="audit-result audit-result-@import.ResultClass">@import.ResultLabel</span>
          }
          else
          {
            <span class="audit-result-empty" aria-label="Результат не применяется">—</span>
          }
        </td>
      </tr>
      @if (import is not null)
      {
        <tr @key="detailsKey" class="hl7-audit-details-row" data-details-for="@item.EventId">
          <td colspan="5">
            <details class="hl7-audit-disclosure">
              <summary>Импорт и сертификат</summary>
              <Hl7ImportAuditDetails Details="import" />
            </details>
          </td>
        </tr>
      }
    }
    </tbody>
  </table>
</div>

@code {
  [Parameter, EditorRequired] public IReadOnlyList<AuditEventDto> Items { get; set; } = [];
}
