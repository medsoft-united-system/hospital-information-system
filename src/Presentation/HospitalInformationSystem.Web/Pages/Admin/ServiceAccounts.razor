@page "/admin/service-accounts"
@attribute [Authorize(Roles = ApplicationRoles.Administrator)]
@using HospitalInformationSystem.Application.Models.ServiceAccounts
@using HospitalInformationSystem.Web.Forms
@using HospitalInformationSystem.Web.Gateways
@using Microsoft.JSInterop
@implements IDisposable
@inject IServiceAccountsGateway Gateway
@inject IJSRuntime Js

<PageTitle>Сервисные аккаунты · Учебная HIS</PageTitle>
<div class="eyebrow"><span class="eyebrow-line"></span> ИНТЕГРАЦИИ УЧРЕЖДЕНИЯ</div>
<div class="page-heading">
  <div><h1>Сервисные аккаунты</h1><p>Доступ внешних систем к HIS по FHIR и HL7.</p></div>
  <button class="btn btn-primary" disabled="@ActionsBlocked" @onclick="BeginCreate"><Icon Name="plus"/> Создать аккаунт</button>
</div>

<div class="integration-summary">
  <div><span class="integration-mark"><Icon Name="pulse"/></span><div><strong>Интеграции внешних систем</strong><p>Роли LIS и HL7 Import · отдельный доступ для каждой системы</p></div></div>
  <p>Ключ выдаётся один раз. При его замене или отключении аккаунта все сервисные сессии отзываются.</p>
</div>

@if (_apiKey is not null)
{
  <section class="surface service-key" role="status" aria-live="polite" aria-label="Новый API key">
    <div class="registry-heading"><div><span class="service-kicker">СОХРАНИТЕ СЕЙЧАС</span><h2>Ключ для @_secretAccountName</h2><p>Передайте ключ оператору @RoleLabel(_secretAccountRole) по защищённому каналу. После закрытия этот ключ больше не отображается.</p></div></div>
    <div class="key-content">
      <label for="service-generated-key">API key</label>
      <div class="key-row"><input id="service-generated-key" class="form-control" readonly value="@_apiKey" aria-label="Новый API key" autocomplete="off" spellcheck="false"/>
        <button class="btn btn-outline-primary" @onclick="CopyKeyAsync">@(_copied ? "Скопировано" : "Копировать")</button></div>
      @if (_revokedSessions is > 0) { <p class="key-help">Отозвано сервисных сессий: @_revokedSessions.</p> }
      <ErrorAlert Message="@_copyError"/>
      <button class="btn btn-light" @onclick="CloseKey">Я сохранил ключ — скрыть</button>
    </div>
  </section>
}

@if (_formOpen)
{
  <section class="surface service-form" aria-label="@(_editing is null ? "Новый сервисный аккаунт" : "Редактирование сервисного аккаунта")">
    <div class="registry-heading"><div><h2>@(_editing is null ? "Новый сервисный аккаунт" : "Изменить имя")</h2><p>Понятное имя поможет найти интеграцию в списке и журнале аудита.</p></div><span class="role-label">@RoleLabel(CurrentRole)</span></div>
    <EditForm Model="_form" OnValidSubmit="SaveAsync">
      <DataAnnotationsValidator/>
      <fieldset disabled="@IsBusy">
        <label for="service-account-name">Имя аккаунта</label>
        <InputText id="service-account-name" class="form-control" @bind-Value="_form.Name" placeholder="Например, LIS основной лаборатории" aria-describedby="service-name-help"/>
        <small id="service-name-help">От 3 до 64 символов.</small>
        <ValidationMessage For="() => _form.Name"/>
        <div class="service-role-field">
          <label for="service-account-role">Роль аккаунта</label>
          @if (_editing is null)
          {
            <InputSelect id="service-account-role" class="form-select" @bind-Value="_form.Role" aria-describedby="service-role-help">
              <option value="@ServiceAccountRoles.Lis">LIS</option>
              <option value="@ServiceAccountRoles.Hl7Import">HL7 Import</option>
            </InputSelect>
            <small id="service-role-help">Роль выбирается при создании аккаунта.</small>
            <ValidationMessage For="() => _form.Role"/>
          }
          else
          {
            <input id="service-account-role" class="form-control" readonly value="@RoleLabel(CurrentRole)" aria-describedby="service-role-help"/>
            <small id="service-role-help">Роль задана при создании аккаунта.</small>
          }
        </div>
        <section class="service-permissions" aria-labelledby="service-permissions-heading">
          <h3 id="service-permissions-heading">Разрешения роли @RoleLabel(CurrentRole)</h3>
          @if (ServiceAccountRoles.IsSupported(CurrentRole))
          {
            <ul>
              <li><span>Получение токенов</span><code>POST /api/service-auth/token</code></li>
              <li><span>Обновление токенов</span><code>POST /api/service-auth/refresh</code></li>
              <li><span>Проверка подключения</span><code>GET /api/testConnection</code></li>
              @if (CurrentRole == ServiceAccountRoles.Lis)
              {
                <li><span>Чтение FHIR</span><span>Patient, Practitioner, ServiceRequest, Observation</span></li>
                <li><span>Создание результата FHIR</span><code>POST /fhir/Observation</code></li>
              }
              else if (CurrentRole == ServiceAccountRoles.Hl7Import)
              {
                <li><span>Импорт пациентов через HL7 v2.8</span><span>MLLP / mTLS</span></li>
              }
            </ul>
          }
          else
          {
            <p>Выберите поддерживаемую роль.</p>
          }
        </section>
        <ErrorAlert Message="@_formError"/>
        <div class="form-actions">
          @if (_formStale)
          {
            <button type="button" class="btn btn-outline-primary" @onclick="ReloadEditingAsync">Загрузить актуальную карточку</button>
          }
          <button type="button" class="btn btn-light" @onclick="CancelForm">Отмена</button>
          <button type="submit" class="btn btn-primary" disabled="@_formStale">@(_busy ? "Сохранение…" : _editing is null ? "Создать и получить ключ" : "Сохранить имя")</button>
        </div>
      </fieldset>
    </EditForm>
  </section>
}

@if (_pending is not null)
{
  <section class="confirm-panel" role="alertdialog" aria-labelledby="service-confirm-title" aria-describedby="service-confirm-description">
    <div><strong id="service-confirm-title">@(_rotate ? "Заменить API key?" : _pending.IsActive ? "Отключить аккаунт?" : "Активировать аккаунт?")</strong><p>@_pending.Name</p>
      <p class="field-hint">@(_pending.IsActive ? "Активен" : "Отключён") · Изменён @FormatDate(_pending.UpdatedAtUtc)</p>
      <p id="service-confirm-description">@(_rotate ? $"Прежний ключ перестанет работать, все сервисные сессии будут отозваны. Новый ключ потребуется передать оператору {RoleLabel(_pending.Role)}." : _pending.IsActive ? $"{RoleLabel(_pending.Role)} потеряет доступ к HIS, все сервисные сессии будут отозваны. Сохранённые результаты останутся в системе." : "Аккаунт сможет получать новые сессии. Ранее отозванные сессии не восстановятся.")</p></div>
    <ErrorAlert Message="@_operationError"/>
    <div class="button-row">
      @if (_pendingStale)
      {
        <button class="btn btn-outline-primary" disabled="@IsBusy" @onclick="ReloadPendingAsync">@(_reloading ? "Загрузка…" : "Загрузить актуальную карточку")</button>
      }
      <button class="btn btn-primary" disabled="@(IsBusy || _pendingStale)" @onclick="ConfirmAsync">@(_busy ? "Сохранение…" : _rotate ? "Заменить ключ" : _pending.IsActive ? "Отключить" : "Активировать")</button>
      <button class="btn btn-light" disabled="@IsBusy" @onclick="CancelConfirmation">Отмена</button>
    </div>
  </section>
}

@if (_notice is not null) { <div class="service-notice" role="status">@_notice</div> }
<ErrorAlert Message="@_listError"/>
<section class="surface service-registry" aria-label="Сервисные аккаунты интеграций" aria-busy="@_loading">
  <div class="registry-heading"><div><h2>Подключения систем</h2><p>Всего: @(_accounts?.Count ?? 0) · Активных: @(_accounts?.Count(x => x.IsActive) ?? 0). Время показано в вашем часовом поясе.</p></div><span class="section-index">ДОСТУП</span></div>
  <div class="table-toolbar service-toolbar">
    <div class="search-field"><Icon Name="search"/><input type="search" aria-label="Поиск сервисного аккаунта" placeholder="Имя аккаунта" @bind="_search" @bind:event="oninput"/></div>
    <select class="form-select" aria-label="Статус сервисного аккаунта" @bind="_statusFilter"><option value="all">Все статусы</option><option value="active">Активные</option><option value="inactive">Отключённые</option></select>
    <button class="btn btn-outline-primary" disabled="@(_loading || IsBusy)" @onclick="LoadAsync">Обновить список</button>
  </div>
  @if (_accounts is null)
  {
    <div class="empty-state" role="status">@(_loading ? "Загрузка аккаунтов…" : "Не удалось загрузить список. Повторите загрузку.")</div>
  }
  else
  {
    <div class="table-responsive"><table class="table mr-table service-table"><thead><tr><th scope="col">Имя</th><th scope="col">Роль</th><th scope="col">Статус</th><th scope="col">Создан</th><th scope="col">Изменён</th><th scope="col" class="actions-cell">Действия</th></tr></thead><tbody>
    @foreach (var account in VisibleAccounts)
    {
      <tr @key="account.Id"><td data-label="Имя" class="service-name">@account.Name</td><td data-label="Роль"><span class="role-label">@RoleLabel(account.Role)</span></td><td data-label="Статус"><span class="service-status @(account.IsActive ? "active" : "inactive")">@(account.IsActive ? "Активен" : "Отключён")</span></td><td data-label="Создан"><time datetime="@account.CreatedAtUtc.ToString("O")">@FormatDate(account.CreatedAtUtc)</time></td><td data-label="Изменён"><time datetime="@account.UpdatedAtUtc.ToString("O")">@FormatDate(account.UpdatedAtUtc)</time></td>
        <td class="actions-cell"><div class="service-actions"><button class="icon-button" title="Изменить имя" aria-label="Изменить имя: @account.Name" disabled="@ActionsBlocked" @onclick="() => BeginEdit(account)"><Icon Name="edit"/></button><button class="btn btn-light" aria-label="Заменить ключ: @account.Name" disabled="@ActionsBlocked" @onclick="() => AskConfirmation(account, true)">Заменить ключ</button><button class="btn btn-light" aria-label="@(account.IsActive ? $"Отключить: {account.Name}" : $"Активировать: {account.Name}")" disabled="@ActionsBlocked" @onclick="() => AskConfirmation(account, false)">@(account.IsActive ? "Отключить" : "Активировать")</button></div></td></tr>
    }
    </tbody></table></div>
    @if (!VisibleAccounts.Any()) { <div class="empty-state">@(_accounts.Count == 0 ? "Создайте сервисный аккаунт, чтобы подключить внешнюю систему." : "По вашему запросу ничего не найдено.")</div> }
    <div class="table-footer"><span>Показано @VisibleAccounts.Count() из @_accounts.Count аккаунтов</span></div>
  }
</section>

@code {
  private IReadOnlyList<ServiceAccountDto>? _accounts;
  private ServiceAccountForm _form = new();
  private ServiceAccountDto? _editing;
  private ServiceAccountDto? _pending;
  private string _search = "";
  private string _statusFilter = "all";
  private string? _listError, _formError, _operationError, _notice;
  private string? _apiKey, _secretAccountName, _secretAccountRole, _copyError;
  private int _revokedSessions, _loadVersion, _keyGeneration;
  private bool _formOpen, _rotate, _busy, _copied, _disposed;
  private bool _formStale, _pendingStale, _reloading;
  private bool _loading = true;
  private CancellationTokenSource? _cts;
  private bool IsBusy => _busy || _reloading;
  private bool ActionsBlocked => IsBusy || _apiKey is not null;
  private string CurrentRole => _editing?.Role ?? _form.Role;
  private IEnumerable<ServiceAccountDto> VisibleAccounts => (_accounts ?? [])
    .Where(x => _statusFilter switch { "active" => x.IsActive, "inactive" => !x.IsActive, _ => true })
    .Where(x => x.Name.Contains(_search.Trim(), StringComparison.OrdinalIgnoreCase))
    .OrderBy(x => x.Name, StringComparer.OrdinalIgnoreCase);

  protected override Task OnInitializedAsync() { _cts = new CancellationTokenSource(); return LoadAsync(); }
  private void BeginCreate() { if (ActionsBlocked || _disposed) return; CancelConfirmation(); _editing = null; _form = new(); _formOpen = true; _formError = null; _formStale = false; _notice = null; }
  private void BeginEdit(ServiceAccountDto account) { if (ActionsBlocked || _disposed) return; CancelConfirmation(); _editing = account; _form = new() { Name = account.Name, Role = account.Role }; _formOpen = true; _formError = null; _formStale = false; _notice = null; }
  private void CancelForm() { if (IsBusy || _disposed) return; _formOpen = false; _form = new(); _editing = null; _formError = null; _formStale = false; }
  private void AskConfirmation(ServiceAccountDto account, bool rotate) { if (ActionsBlocked || _disposed) return; CancelForm(); _pending = account; _rotate = rotate; _operationError = null; _pendingStale = false; _notice = null; }
  private void CancelConfirmation() { if (IsBusy || _disposed) return; _pending = null; _operationError = null; _pendingStale = false; }

  private async Task SaveAsync()
  {
    if (ActionsBlocked || _formStale || _disposed || _cts is null || !ServiceAccountNameRules.IsValid(_form.Name) || !ServiceAccountRoles.IsSupported(CurrentRole)) return;
    var token = _cts.Token;
    _busy = true; _formError = null; ++_loadVersion;
    try
    {
      if (_editing is { } editing)
      {
        var saved = await Gateway.UpdateAsync(editing.Id, new UpdateServiceAccountRequest(_form.Name.Trim(), editing.Version), token);
        if (!IsCurrent(token)) return;
        ApplySaved(saved); _notice = "Имя сервисного аккаунта сохранено.";
      }
      else
      {
        var saved = await Gateway.CreateAsync(new CreateServiceAccountRequest(_form.Name.Trim(), _form.Role), token);
        if (!IsCurrent(token)) return;
        ApplySaved(saved.Account); ShowKey(saved);
      }
      _formOpen = false; _form = new(); _editing = null;
      await LoadAsync();
    }
    catch (OperationCanceledException) when (!IsCurrent(token)) { }
    catch (ApiException exception) when (exception.StatusCode == System.Net.HttpStatusCode.Conflict && _editing is not null)
    {
      if (IsCurrent(token))
      {
        _formStale = true;
        _formError = "Аккаунт уже изменён или имя занято. Введённое имя сохранено в форме. Загрузите актуальную карточку, затем повторно внесите изменения. Загрузка заменит введённое имя.";
      }
    }
    catch (Exception exception) when (exception is ApiException or HttpRequestException or OperationCanceledException)
    { if (IsCurrent(token)) _formError = FailureMessage(exception); }
    finally { if (IsCurrent(token)) { _busy = false; _loading = false; } }
  }

  private async Task ConfirmAsync()
  {
    if (ActionsBlocked || _pendingStale || _disposed || _cts is null || _pending is not { } pending) return;
    var token = _cts.Token;
    _busy = true; _operationError = null; ++_loadVersion;
    try
    {
      if (_rotate)
      {
        var saved = await Gateway.RotateKeyAsync(pending.Id, new RotateServiceAccountKeyRequest(pending.Version), token);
        if (!IsCurrent(token)) return;
        ApplySaved(saved.Account); ShowKey(saved);
      }
      else
      {
        var saved = await Gateway.SetActiveAsync(pending.Id, new SetServiceAccountActiveRequest(!pending.IsActive, pending.Version), token);
        if (!IsCurrent(token)) return;
        ApplySaved(saved.Account);
        _notice = saved.Account.IsActive ? "Аккаунт активирован. Отозванные сессии не восстанавливаются." : $"Аккаунт отключён. Отозвано сервисных сессий: {saved.RevokedSessionCount}.";
      }
      _pending = null;
      await LoadAsync();
    }
    catch (OperationCanceledException) when (!IsCurrent(token)) { }
    catch (ApiException exception) when (exception.StatusCode == System.Net.HttpStatusCode.Conflict)
    {
      if (IsCurrent(token))
      {
        _pendingStale = true;
        _operationError = "Аккаунт уже изменён. Загрузите актуальную карточку, проверьте состояние и подтвердите действие повторно.";
      }
    }
    catch (Exception exception) when (exception is ApiException or HttpRequestException or OperationCanceledException)
    { if (IsCurrent(token)) _operationError = FailureMessage(exception); }
    finally { if (IsCurrent(token)) { _busy = false; _loading = false; } }
  }

  private async Task ReloadEditingAsync()
  {
    if (ActionsBlocked || !_formStale || _disposed || _cts is null || _editing is not { } editing) return;
    var token = _cts.Token;
    _reloading = true;
    ++_loadVersion;
    try
    {
      var current = await Gateway.GetAsync(editing.Id, token);
      if (!IsCurrent(token)) return;
      ApplySaved(current);
      _editing = current;
      _form = new ServiceAccountForm { Name = current.Name, Role = current.Role };
      _formStale = false;
      _formError = null;
    }
    catch (OperationCanceledException) when (!IsCurrent(token)) { }
    catch (Exception exception) when (exception is ApiException or HttpRequestException or OperationCanceledException)
    { if (IsCurrent(token)) _formError = ReloadFailureMessage(exception); }
    finally { if (IsCurrent(token)) { _reloading = false; _loading = false; } }
  }

  private async Task ReloadPendingAsync()
  {
    if (ActionsBlocked || !_pendingStale || _disposed || _cts is null || _pending is not { } pending) return;
    var token = _cts.Token;
    _reloading = true;
    ++_loadVersion;
    try
    {
      var current = await Gateway.GetAsync(pending.Id, token);
      if (!IsCurrent(token)) return;
      ApplySaved(current);
      _pending = _rotate || current.IsActive == pending.IsActive ? current : null;
      _pendingStale = false;
      _operationError = null;
      if (_pending is null)
        _notice = current.IsActive ? "Аккаунт уже активирован." : "Аккаунт уже отключён.";
    }
    catch (OperationCanceledException) when (!IsCurrent(token)) { }
    catch (Exception exception) when (exception is ApiException or HttpRequestException or OperationCanceledException)
    { if (IsCurrent(token)) _operationError = ReloadFailureMessage(exception); }
    finally { if (IsCurrent(token)) { _reloading = false; _loading = false; } }
  }

  private static string ReloadFailureMessage(Exception exception) => exception is ApiException api &&
    api.StatusCode is System.Net.HttpStatusCode.Unauthorized or System.Net.HttpStatusCode.Forbidden or System.Net.HttpStatusCode.NotFound
      ? FailureMessage(exception)
      : "Не удалось загрузить актуальную карточку. Повторите загрузку перед подтверждением действия.";

  private void ShowKey(ServiceAccountKeyResultDto saved) { ++_keyGeneration; _apiKey = saved.ApiKey; _secretAccountName = saved.Account.Name; _secretAccountRole = saved.Account.Role; _revokedSessions = saved.RevokedSessionCount; _copied = false; _copyError = null; _notice = null; }
  private void CloseKey() { ++_keyGeneration; _apiKey = null; _secretAccountName = null; _secretAccountRole = null; _copyError = null; _copied = false; _revokedSessions = 0; }
  private async Task CopyKeyAsync()
  {
    if (_apiKey is not { } key || _disposed) return;
    var generation = _keyGeneration;
    _copyError = null;
    try { await Js.InvokeVoidAsync("navigator.clipboard.writeText", _cts?.Token ?? CancellationToken.None, key); if (!_disposed && generation == _keyGeneration) _copied = true; }
    catch (OperationCanceledException) when (_disposed || _cts?.IsCancellationRequested == true) { }
    catch (Exception exception) when (exception is JSException or InvalidOperationException)
    { if (!_disposed && generation == _keyGeneration) _copyError = "Не удалось скопировать ключ автоматически. Выделите его и скопируйте вручную."; }
  }

  private void ApplySaved(ServiceAccountDto saved) => _accounts = (_accounts ?? []).Where(x => x.Id != saved.Id).Append(saved).ToArray();
  private async Task LoadAsync()
  {
    if (_disposed || _cts is null) return;
    var token = _cts.Token; var version = ++_loadVersion;
    _loading = true; _listError = null;
    try { var loaded = await Gateway.ListAsync(token); if (IsCurrent(token) && version == _loadVersion) _accounts = loaded; }
    catch (OperationCanceledException) when (!IsCurrent(token)) { }
    catch (Exception exception) when (exception is ApiException or HttpRequestException or OperationCanceledException)
    { if (IsCurrent(token) && version == _loadVersion) _listError = "Не удалось обновить список. Подтверждённые изменения сохранены на экране; повторите загрузку."; }
    finally { if (IsCurrent(token) && version == _loadVersion) _loading = false; }
  }
  private static string FailureMessage(Exception exception) => exception is ApiException api ? api.StatusCode switch
  {
    System.Net.HttpStatusCode.Unauthorized => "Сессия завершена. Войдите снова и проверьте состояние аккаунта.",
    System.Net.HttpStatusCode.Forbidden => "У вас нет прав управления сервисными аккаунтами.",
    System.Net.HttpStatusCode.BadRequest => "Проверьте имя, роль и актуальность версии аккаунта. Обновите список перед новой отправкой.",
    System.Net.HttpStatusCode.NotFound => "Аккаунт не найден. Обновите список.",
    System.Net.HttpStatusCode.Conflict => "Данные уже изменены или имя занято. Обновите список и заново подтвердите действие.",
    _ => "Не удалось подтвердить результат операции. Обновите список и проверьте состояние аккаунта перед повторной отправкой."
  } : "Не удалось подтвердить результат операции. Обновите список и проверьте состояние аккаунта перед повторной отправкой.";
  private static string RoleLabel(string? role) => role switch
  {
    ServiceAccountRoles.Lis => "LIS",
    ServiceAccountRoles.Hl7Import => "HL7 Import",
    _ => "Неизвестная роль"
  };
  private static string FormatDate(DateTimeOffset value) => value.ToLocalTime().ToString("dd.MM.yyyy HH:mm:ss");
  private bool IsCurrent(CancellationToken token) => !_disposed && !token.IsCancellationRequested;
  public void Dispose() { if (_disposed) return; CloseKey(); _disposed = true; _cts?.Cancel(); _cts?.Dispose(); }
}
