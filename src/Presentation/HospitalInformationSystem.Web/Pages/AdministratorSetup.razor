@page "/admin/setup"
@layout LoginLayout
@implements IDisposable
@using HospitalInformationSystem.Contracts.Security
@using HospitalInformationSystem.Web.Gateways
@inject IAuthenticationGateway Authentication

<PageTitle>Настройка администратора · Учебная HIS</PageTitle>
<section class="surface login-card">
  <h1>Первоначальная настройка</h1>
  <ErrorAlert Message="@_error"/>
  @if (_loading)
  {
    <p role="status">Проверяем состояние настройки…</p>
  }
  else if (_completed)
  {
    <p>Настройка завершена. Для входа дождитесь следующего шестизначного кода в приложении-аутентификаторе.</p>
    <a href="/admin/login">Войти администратором</a>
  }
  else if (_available == false)
  {
    <p>Первоначальная настройка уже завершена.</p>
    <a href="/admin/login">Перейти ко входу</a>
  }
  else if (_available == true && _challenge is null)
  {
    <p>Потребуются локальный токен владельца стенда и приложение-аутентификатор.</p>
    <EditForm Model="_form" OnValidSubmit="BeginAsync">
      <DataAnnotationsValidator/>
      <ValidationSummary/>
      <fieldset disabled="@_busy">
        <div class="mr-field">
          <label for="setup-token">Токен владельца</label>
          <InputText id="setup-token" class="form-control" type="password" @bind-Value="_form.OwnerToken"
                     autocomplete="off" maxlength="256"/>
        </div>
        <div class="mr-field">
          <label for="setup-password">Пароль администратора</label>
          <InputText id="setup-password" class="form-control" type="password" @bind-Value="_form.Password"
                     autocomplete="new-password" maxlength="128"/>
          <p class="field-hint">12–128 символов, минимум одна прописная и строчная латинская буква и цифра.</p>
        </div>
        <div class="mr-field">
          <label for="setup-confirm">Подтверждение пароля</label>
          <InputText id="setup-confirm" class="form-control" type="password" @bind-Value="_form.ConfirmPassword"
                     autocomplete="new-password" maxlength="128"/>
        </div>
        <button class="btn btn-primary" type="submit">Продолжить</button>
      </fieldset>
    </EditForm>
  }
  else if (_challenge is { } challenge)
  {
    <p>Добавьте в приложении-аутентификаторе учётную запись TOTP: SHA1, 6 цифр, период 30 секунд.</p>
    <label for="totp-secret">Секрет для ручного ввода</label>
    <input id="totp-secret" class="form-control" value="@challenge.SecretKey" readonly autocomplete="off"/>
    <details><summary>Данные подключения аутентификатора</summary><code style="overflow-wrap:anywhere">@challenge.AuthenticatorUri</code></details>
    <p>Попытка действует до @challenge.ExpiresAt.ToLocalTime().ToString("HH:mm:ss"). После подтверждения секрет исчезнет с этой страницы.</p>
    <EditForm Model="_confirmation" OnValidSubmit="ConfirmAsync">
      <DataAnnotationsValidator/>
      <ValidationSummary/>
      <fieldset disabled="@_busy">
        <label for="setup-code">Код из приложения</label>
        <InputText id="setup-code" class="form-control" @bind-Value="_confirmation.Code" maxlength="6"
                   inputmode="numeric" autocomplete="one-time-code"/>
        <button class="btn btn-primary" type="submit">Подтвердить настройку</button>
        <button class="btn btn-light" type="button" @onclick="Restart">Начать заново</button>
      </fieldset>
    </EditForm>
  }
</section>

@code {
  private readonly SetupForm _form = new();
  private readonly ConfirmationForm _confirmation = new();
  private readonly CancellationTokenSource _cancellation = new();
  private SetupChallengeDto? _challenge;
  private bool? _available;
  private bool _loading = true;
  private bool _busy;
  private bool _completed;
  private string? _error;

  protected override async Task OnInitializedAsync()
  {
    try { _available = (await Authentication.GetSetupStatusAsync(_cancellation.Token)).SetupRequired; }
    catch (Exception exception) when (exception is ApiException or HttpRequestException or OperationCanceledException)
    { if (!_cancellation.IsCancellationRequested) _error = "Не удалось проверить состояние настройки. Обновите страницу."; }
    finally { _loading = false; }
  }

  private async Task BeginAsync()
  {
    if (_busy) return;
    _busy = true;
    _error = null;
    try
    {
      _challenge = await Authentication.BeginSetupAsync(new BeginSetupRequest(_form.Password, _form.ConfirmPassword),
        _form.OwnerToken, _cancellation.Token);
      _form.Password = _form.ConfirmPassword = "";
    }
    catch (ApiException exception) { _error = exception.Message; }
    catch (Exception exception) when (exception is HttpRequestException or OperationCanceledException)
    { if (!_cancellation.IsCancellationRequested) _error = "Не удалось начать настройку. Повторите попытку."; }
    finally { _busy = false; }
  }

  private async Task ConfirmAsync()
  {
    if (_busy || _challenge is null) return;
    _busy = true;
    _error = null;
    try
    {
      await Authentication.ConfirmSetupAsync(new ConfirmSetupRequest(_challenge.ChallengeId, _confirmation.Code),
        _form.OwnerToken, _cancellation.Token);
      ClearSecrets();
      _completed = true;
    }
    catch (ApiException exception) { _error = exception.Message; }
    catch (Exception exception) when (exception is HttpRequestException or OperationCanceledException)
    { if (!_cancellation.IsCancellationRequested) _error = "Результат подтверждения неизвестен. Проверьте состояние настройки, обновив страницу."; }
    finally { _confirmation.Code = ""; _busy = false; }
  }

  private void Restart() { _challenge = null; _confirmation.Code = ""; _error = null; }
  private void ClearSecrets() { _form.Password = _form.ConfirmPassword = _form.OwnerToken = _confirmation.Code = ""; _challenge = null; }
  public void Dispose() { _cancellation.Cancel(); ClearSecrets(); _cancellation.Dispose(); }

  private sealed class SetupForm
  {
    [Required, StringLength(256)] public string OwnerToken { get; set; } = "";
    [Required, StringLength(128, MinimumLength = 12)] public string Password { get; set; } = "";
    [Required, Compare(nameof(Password))] public string ConfirmPassword { get; set; } = "";
  }

  private sealed class ConfirmationForm
  {
    [Required, RegularExpression("[0-9]{6}", ErrorMessage = "Укажите код из шести цифр.")]
    public string Code { get; set; } = "";
  }
}
