{
  "Database": {
    "ApplyMigrations": false,
    "Seed": false
  },
  "Authentication": {
    "ServiceJwt": {
      "Issuer": "MedSoft.Api",
      "Audience": "MedSoft.Lis",
      "AccessTokenMinutes": 5,
      "RefreshTokenDays": 7
    }
  },
  "Security": {
    "ServiceAuthRateLimit": {
      "PermitLimit": 10
    },
    "PasswordHashing": {
      "Argon2id": {
        "MemorySizeKiB": 65536,
        "Iterations": 3,
        "Parallelism": 1
      }
    }
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "localhost;127.0.0.1;[::1]",
  "Hl7Import": {
    "Enabled": false,
    "ListenAddress": "127.0.0.1",
    "Port": 2575,
    "ServerCertificate": {
      "PfxPath": "",
      "PasswordFile": ""
    },
    "ClientTrust": {
      "CaCertificatePath": ""
    },
    "Timeouts": {
      "HandshakeSeconds": 10,
      "FrameReadSeconds": 30,
      "ProcessingSeconds": 30,
      "WriteSeconds": 10,
      "ShutdownSeconds": 10
    },
    "Limits": {
      "MaxPayloadBytes": 1048576,
      "MaxConnections": 16,
      "Backlog": 32
    }
  }
}
